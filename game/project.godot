; Mobil açık-dünya oyun altyapısı — Godot 4.6.2, gl_compatibility

config_version=5

[application]

config/name="TrollAnimalSim"
config/description="Çılgın troll hayvan simülatörü — altyapı"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.6")
boot_splash/show_image=false

[autoload]

EventBus="*res://autoload/event_bus.gd"
Settings="*res://autoload/settings.gd"
AssetRegistry="*res://autoload/asset_registry.gd"
QualityManager="*res://autoload/quality_manager.gd"
SaveSystem="*res://autoload/save_system.gd"
Services="*res://autoload/services.gd"
GameRoot="*res://autoload/game_root.gd"

[debug]

settings/stdout/verbose_stdout=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.56, 0.79, 0.92, 1)
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
